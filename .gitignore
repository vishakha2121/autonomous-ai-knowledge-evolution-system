# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=knowledge_chunks

# App
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
